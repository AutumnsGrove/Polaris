# Copy this to config.yaml and fill in secrets via environment variables
# (never commit real API keys — config.yaml is gitignored).

server:
  host: "127.0.0.1"   # loopback only, including on the potato — tailscale serve binds the
                       # tailnet IP itself on this same port to terminate HTTPS and proxies to
                       # localhost, so 0.0.0.0 collides with it and crash-loops on every reboot
  port: 8899

openrouter:
  api_key: "${OPENROUTER_API_KEY}"
  base_url: "https://openrouter.ai/api/v1"

searxng:
  base_url: "http://localhost:18888"   # local dev; point at http://100.81.103.51:8888 on the potato

# Domains web_search/web_read must never surface or fetch — see
# blocked_sources.txt for the actual list (one domain per line, edit it
# directly, no code changes needed). Defaults to ./blocked_sources.txt;
# only set this if you want it somewhere else.
# blocked_sources_file: "./blocked_sources.txt"

foursquare:
  api_key: "${FOURSQUARE_API_KEY}"   # optional — nearby_search falls back to SearXNG without it. Free tier: 10k calls/month. https://foursquare.com/developers

tavily:
  api_key: "${TAVILY_API_KEY}"   # optional — web_read's last-resort fallback for JS-rendered/paywalled pages that goquery and archive.org can't get through. Costs credits per call, so it's never the default fetch path. https://tavily.com

brave:
  api_key: "${BRAVE_API_KEY}"   # optional — web_search's first-tried fallback when SearXNG itself is degraded (see search.SearchResponse.Degraded), ahead of Parallel/Tavily; also Atlas's own fallback for real, multi-result listings. No ongoing free tier (a one-time $5/mo signup credit only) — see store.Store's api_usage table, which enforces a 1,000/mo cap in code. https://brave.com/search/api/

parallel:
  api_key: "${PARALLEL_API_KEY}"   # optional — web_search's fallback when SearXNG itself is degraded (see search.SearchResponse.Degraded), tried after Brave, before Tavily. Free tier: 5,000 searches/month, but the account has a card on file — see store.Store's api_usage table, which enforces that cap in code rather than trusting the free tier not to bill overage. https://parallel.ai

ollama:
  base_url: "http://localhost:11434"   # optional — empty disables agent.Run's query-similarity stale-search signal (agent/query_similarity.go) only, nothing else. Point at a LOCAL Ollama instance serving embed_model, never a shared/remote one — see config.Config's Ollama field doc comment.
  embed_model: "nomic-embed-text"   # defaults to this if left empty

reddit:
  client_id: "${REDDIT_CLIENT_ID}"       # optional — Reddit blocks ordinary page fetches, so web_read reads Reddit through its API with these credentials, falling back to Reddit's public RSS feeds (flat text, rate-limited, no key) when empty or when the API call fails. New app registrations are mostly refused now, but an existing app's credentials (e.g. an old third-party-client app) keep working. https://www.reddit.com/prefs/apps
  client_secret: "${REDDIT_CLIENT_SECRET}"   # leave empty for an "installed app" credential (those have no secret)

github:
  token: "${GITHUB_TOKEN}"   # optional — github_repo works unauthenticated (60 requests/hour); a token raises that to 5000/hour. No scopes needed for public repos. https://github.com/settings/tokens

lastfm:
  api_key: "${LASTFM_API_KEY}"   # required for the music tool — no unauthenticated fallback. Free, no approval wait. https://www.last.fm/api/account/create

hardcover:
  api_key: "${HARDCOVER_API_KEY}"   # optional — the books tool falls back to Open Library (no key needed) without it, just with weaker recommendations. Free account, token under Settings > API. Expires after ~1 year. https://hardcover.app

tmdb:
  api_key: "${TMDB_API_KEY}"   # required for the movies tool — no unauthenticated fallback. Free, no approval wait. https://www.themoviedb.org/settings/api

# Geocoded when nearby_search omits a location. Optional — omit entirely
# to require an explicit location on every nearby_search call.
default_location: ""   # e.g. "Seattle, WA" or "47.6062, -122.3321"

# Push-to-talk transcription and read-aloud replies, both via OpenRouter
# (no local sidecar processes — this is a stateless web app, not a
# persistent companion process like her-go).
voice:
  stt_model: "mistralai/voxtral-mini-transcribe"
  stt_fallback_model: "openai/whisper-large-v3"   # tried once if the primary model times out/errors
  tts_model: "hexgrad/kokoro-82m"
  tts_voice: "bf_lily"   # default voice until one is picked in Settings (bf_lily, af_sky, am_onyx, bm_daniel)
  tts_format: "mp3"      # OpenRouter's Kokoro endpoint only documents mp3/pcm
  tts_provider: "Together"   # pinned provider for Kokoro's /audio/speech calls — DeepInfra is cheaper
                              # but has shown 15-40s+ latency (sometimes past our own timeout); Together
                              # has tested consistently ~12-13s. Empty lets OpenRouter route/fail over itself.

database:
  path: "./polaris.db"

logging:
  dir: "./logs"   # one file per day (YYYY-MM-DD.log), 90-day retention, pruned automatically

# backup:
#   dir: "./backups"        # default: a "backups" folder next to database.path above
#   retention_days: 30      # how long a daily backup is kept before it's pruned
#
# Uncomment to override either default. A daily backup (via SQLite's own
# VACUUM INTO — a consistent snapshot that doesn't block the running
# server) is taken automatically in the background; `polaris backup list`/
# `create`/`restore` manage them by hand. See README's Backups section.

# r2:
#   account_id: "${R2_ACCOUNT_ID}"
#   access_key_id: "${R2_ACCESS_KEY_ID}"
#   secret_access_key: "${R2_SECRET_ACCESS_KEY}"
#   bucket: "polaris-backups"
#
# Uncomment and fill in to mirror every backup to a dedicated Cloudflare R2
# bucket, off this device — in addition to, not instead of, the local
# backups/ folder above, so the device itself failing doesn't take every
# backup with it. Create a bucket just for this and a scoped R2 API token
# (Object Read & Write on that bucket only, not an account-wide key):
# https://developers.cloudflare.com/r2/api/tokens/
# Once configured, `polaris backup list --remote` shows what's actually
# recoverable from R2, and `polaris backup restore-remote <name>` is the
# disaster-recovery path — pulls a backup down from R2 and restores it, for
# when the local backups/ folder itself is gone. Leaving this whole section
# unset disables R2 entirely; nothing else about local backups changes.

attachments:
  dir: "./attachments"   # uploaded PDFs/images from the composer's "+" menu

# code_exec: the sandboxed Python tool. The sandbox itself always runs in
# Docker (compose/watcher/codeexec.sh does `docker run --network none
# --cap-drop=ALL ...` against ghcr.io/autumnsgrove/polaris-sandbox) — but
# Polaris itself doesn't need to be containerized to use it. Run
# codeexec.sh as a plain foreground process (it watches signal_dir on its
# own; no systemd needed for dev) alongside `go run .`, with Docker
# installed locally for the sandbox container. Uncomment to enable:
code_exec:
  workspace_dir: "./workspaces"
  # Same path as workspace_dir here specifically because bare-metal has no
  # container boundary to translate across — Docker's own compose config
  # legitimately differs (this container's path vs. the host's real path).
  host_workspace_dir: "./workspaces"
  signal_dir: "./code-exec-signal"
  memory_limit_mb: 384
  pids_limit: 64
  timeout_seconds: 30

service:
  label: "polaris"

# Threshold (prompt + completion tokens) at which a thread auto-compacts:
# the model summarizes everything so far and future turns continue from
# that summary instead of the full raw history. Also the denominator for
# the context-usage % shown next to thread cost in the UI.
context_window_tokens: 200000

# Bounds one turn's tool-use loop (search/read/nearby_search calls) before
# the model is forced to wrap up with whatever it's gathered so far. Only
# meant to stop a genuinely stuck model from looping forever — the more
# agentic models routinely use 5-8 calls on a real multi-part question.
max_agent_turns: 50

default_model: "deepseek"

# Optional: override per-model settings from the registry (models/models.go).
# The available models are defined in code and deployed with the binary —
# config is for tuning their behavior, not declaring what exists.
# All fields are optional; unset fields inherit from the code defaults.
#
# model_overrides:
#   mimo-pro:
#     temperature: 0.7
#     max_tokens: 16000
#   deepseek:
#     reasoning:
#       effort: "high"

# Oracle mode tuning (opt-in in Settings; see README). Thresholds are the
# minimum probability Jev's answer needs for a check to fire; the lists
# decide which focus modes Oracle may pick, keep, or skip. All of this is
# optional — anything left out uses the value shown here — and it's re-read
# on every turn, so edits take effect without a restart. The wording Jev is
# asked, and the text injected into the answer, lives in prompts.yaml.
oracle:
  checks:
    focus:
      threshold: 0.70           # bar for Oracle to pick a focus mode at all
      switch_threshold: 0.85    # higher bar to change a mode Oracle already set
      # Per-mode bars above `threshold`. Brief can make an answer worse if
      # picked wrongly; Safari takes over the whole thread.
      option_thresholds:
        brief: 0.80
        safari: 0.85
      sticky: [safari]          # never switched away from once set for a thread
      never_with_high_stakes: [brief]   # not picked when high_stakes fired
    research:
      threshold: 0.85
    high_stakes:
      threshold: 0.75
    intent:
      threshold: 0.65
      # Shopper mode already carries its own product guidance.
      skip_option_for_focus:
        product: [shopper]
    clarify:
      threshold: 0.85
      first_message_only: true
      skip_for_focus: [safari]  # Safari's Embark step already asks
    recall:
      threshold: 0.80
    # Answer shape. Safari owns its own format; Brief is already short.
    format:
      threshold: 0.75
      skip_for_focus: [safari]
    depth:
      threshold: 0.80
      skip_for_focus: [safari, brief]
    # Source and evidence guidance.
    recency:
      threshold: 0.75
    source_type:
      threshold: 0.75
      # Academic mode already carries its own source guidance.
      skip_option_for_focus:
        academic: [academic]
    contested:
      threshold: 0.80
    claim_check:
      threshold: 0.80
    locale:
      threshold: 0.75
    # What the person is doing. These modes already teach the same way.
    task:
      threshold: 0.75
      skip_for_focus: [safari]
      skip_option_for_focus:
        explain: [first_principles, socratic]
    # Sensitivity: wrongly firing these changes tone, so the bar is high.
    emotional:
      threshold: 0.85
      # Tone over structure: someone who's struggling shouldn't also get a
      # table format, an agency-citation nudge, a step-by-step plan, or a
      # "stop and ask a question first" stacked on top. High-stakes, locale,
      # and freshness stay — those carry facts, not tone.
      suppresses: [format, depth, source_type, task, clarify]
    private_person:
      threshold: 0.85
    premise:
      threshold: 0.85
  # Offer chips shown under a reply.
  chips:
    pulsar:
      threshold: 0.80
    daily:
      threshold: 0.80
    safari:
      threshold: 0.85
    field:
      threshold: 0.75
