# Copy this to config.yaml and fill in secrets via environment variables
# (never commit real API keys — config.yaml is gitignored).

server:
  host: "127.0.0.1"   # loopback only, including on the potato — tailscale serve binds the
                       # tailnet IP itself on this same port to terminate HTTPS and proxies to
                       # localhost, so 0.0.0.0 collides with it and crash-loops on every reboot
  port: 8899

openrouter:
  api_key: "${OPENROUTER_API_KEY}"
  base_url: "https://openrouter.ai/api/v1"

searxng:
  base_url: "http://localhost:18888"   # local dev; point at http://100.81.103.51:8888 on the potato

# Domains web_search/web_read must never surface or fetch — see
# blocked_sources.txt for the actual list (one domain per line, edit it
# directly, no code changes needed). Defaults to ./blocked_sources.txt;
# only set this if you want it somewhere else.
# blocked_sources_file: "./blocked_sources.txt"

foursquare:
  api_key: "${FOURSQUARE_API_KEY}"   # optional — nearby_search falls back to SearXNG without it. Free tier: 10k calls/month. https://foursquare.com/developers

tavily:
  api_key: "${TAVILY_API_KEY}"   # optional — web_read's last-resort fallback for JS-rendered/paywalled pages that goquery and archive.org can't get through. Costs credits per call, so it's never the default fetch path. https://tavily.com

brave:
  api_key: "${BRAVE_API_KEY}"   # optional — web_search's first-tried fallback when SearXNG itself is degraded (see search.SearchResponse.Degraded), ahead of Parallel/Tavily; also Atlas's own fallback for real, multi-result listings. No ongoing free tier (a one-time $5/mo signup credit only) — see store.Store's api_usage table, which enforces a 1,000/mo cap in code. https://brave.com/search/api/

parallel:
  api_key: "${PARALLEL_API_KEY}"   # optional — web_search's fallback when SearXNG itself is degraded (see search.SearchResponse.Degraded), tried after Brave, before Tavily. Free tier: 5,000 searches/month, but the account has a card on file — see store.Store's api_usage table, which enforces that cap in code rather than trusting the free tier not to bill overage. https://parallel.ai

github:
  token: "${GITHUB_TOKEN}"   # optional — github_repo works unauthenticated (60 requests/hour); a token raises that to 5000/hour. No scopes needed for public repos. https://github.com/settings/tokens

lastfm:
  api_key: "${LASTFM_API_KEY}"   # required for the music tool — no unauthenticated fallback. Free, no approval wait. https://www.last.fm/api/account/create

hardcover:
  api_key: "${HARDCOVER_API_KEY}"   # optional — the books tool falls back to Open Library (no key needed) without it, just with weaker recommendations. Free account, token under Settings > API. Expires after ~1 year. https://hardcover.app

tmdb:
  api_key: "${TMDB_API_KEY}"   # required for the movies tool — no unauthenticated fallback. Free, no approval wait. https://www.themoviedb.org/settings/api

# Geocoded when nearby_search omits a location. Optional — omit entirely
# to require an explicit location on every nearby_search call.
default_location: ""   # e.g. "Seattle, WA" or "47.6062, -122.3321"

# Push-to-talk transcription and read-aloud replies, both via OpenRouter
# (no local sidecar processes — this is a stateless web app, not a
# persistent companion process like her-go).
voice:
  stt_model: "mistralai/voxtral-mini-transcribe"
  stt_fallback_model: "openai/whisper-large-v3"   # tried once if the primary model times out/errors
  tts_model: "hexgrad/kokoro-82m"
  tts_voice: "bf_lily"   # British female "Lily" — see hexgrad/Kokoro-82M's VOICES.md for the full list
  tts_format: "mp3"      # OpenRouter's Kokoro endpoint only documents mp3/pcm
  tts_provider: "Together"   # pinned provider for Kokoro's /audio/speech calls — DeepInfra is cheaper
                              # but has shown 15-40s+ latency (sometimes past our own timeout); Together
                              # has tested consistently ~12-13s. Empty lets OpenRouter route/fail over itself.

database:
  path: "./polaris.db"

logging:
  dir: "./logs"   # one file per day (YYYY-MM-DD.log), 90-day retention, pruned automatically

attachments:
  dir: "./attachments"   # uploaded PDFs/images from the composer's "+" menu

service:
  label: "polaris"

# Threshold (prompt + completion tokens) at which a thread auto-compacts:
# the model summarizes everything so far and future turns continue from
# that summary instead of the full raw history. Also the denominator for
# the context-usage % shown next to thread cost in the UI.
context_window_tokens: 100000

# Bounds one turn's tool-use loop (search/read/nearby_search calls) before
# the model is forced to wrap up with whatever it's gathered so far. Only
# meant to stop a genuinely stuck model from looping forever — the more
# agentic models routinely use 5-8 calls on a real multi-part question.
max_agent_turns: 50

default_model: "deepseek"

# Optional: override per-model settings from the registry (models/models.go).
# The available models are defined in code and deployed with the binary —
# config is for tuning their behavior, not declaring what exists.
# All fields are optional; unset fields inherit from the code defaults.
#
# model_overrides:
#   mimo-pro:
#     temperature: 0.7
#     max_tokens: 16000
#   deepseek:
#     reasoning:
#       effort: "high"
