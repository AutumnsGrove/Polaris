# Docker Compose variant of ../../config.yaml.example — same fields,
# see that file's comments for what each one does. The only real
# differences are:
#   - server.host is 0.0.0.0, not 127.0.0.1: this now binds inside its
#     own container's network namespace, not the host directly, so there's
#     no Tailscale-collision concern (see the bare-metal example's comment
#     on that).
#   - database/logging/attachments paths point at /data, the volume
#     mounted into the polaris container (see docker-compose.yml) — the
#     working directory inside the container isn't where you'd expect
#     persistent state to land otherwise.
#   - searxng.base_url points at the searxng service by its Compose
#     service name, not localhost:18888 — Compose's built-in DNS resolves
#     "searxng" to the right container on the internal network.
#
# Copy this to compose/polaris/config.yaml before `docker compose up` —
# gitignored the same way the bare-metal config.yaml is.

server:
  host: "0.0.0.0"
  port: 8899

openrouter:
  api_key: "${OPENROUTER_API_KEY}"
  base_url: "https://openrouter.ai/api/v1"

searxng:
  base_url: "http://searxng:8080"

foursquare:
  api_key: "${FOURSQUARE_API_KEY}"

tavily:
  api_key: "${TAVILY_API_KEY}"

brave:
  api_key: "${BRAVE_API_KEY}"

parallel:
  api_key: "${PARALLEL_API_KEY}"

ollama:
  # docker-compose.yml's extra_hosts entry routes host.docker.internal to
  # the Docker bridge gateway — but that alone isn't enough: Ollama
  # defaults to binding 127.0.0.1 only, which REFUSES connections
  # arriving via the bridge gateway (confirmed live: "connection
  # refused", not just slow). Ollama itself must be rebound to 0.0.0.0
  # (OLLAMA_HOST=0.0.0.0:11434 in its systemd unit/launch config) before
  # this URL does anything. That widens Ollama's reach to your whole LAN,
  # not just Docker, since it has no built-in auth — only do this on a
  # host with no untrusted local network users. Empty base_url just
  # disables agent.Run's query-similarity stale-search signal, nothing
  # else breaks — see config.Config's Ollama field doc comment.
  base_url: "http://host.docker.internal:11434"
  embed_model: "nomic-embed-text"

github:
  token: "${GITHUB_TOKEN}"

lastfm:
  api_key: "${LASTFM_API_KEY}"

hardcover:
  api_key: "${HARDCOVER_API_KEY}"

tmdb:
  api_key: "${TMDB_API_KEY}"

default_location: ""

voice:
  stt_model: "mistralai/voxtral-mini-transcribe"
  stt_fallback_model: "openai/whisper-large-v3"
  tts_model: "hexgrad/kokoro-82m"
  tts_voice: "bf_lily"
  tts_format: "mp3"
  tts_provider: "Together"

database:
  path: "/data/polaris.db"

logging:
  dir: "/data/logs"

# backup:
#   dir: "/data/backups"    # default: a "backups" folder next to database.path above —
#                            # already inside the polaris-data named volume, no extra
#                            # mount needed (see docker-compose.yml)
#   retention_days: 30

# r2:
#   account_id: "${R2_ACCOUNT_ID}"
#   access_key_id: "${R2_ACCESS_KEY_ID}"
#   secret_access_key: "${R2_SECRET_ACCESS_KEY}"
#   bucket: "polaris-backups"
#
# Mirrors every backup off-device to R2 — see ../../config.yaml.example's
# comment for the full explanation. docker-compose.yml already passes the
# three R2_* vars through from .env the same way the other secrets are.

attachments:
  dir: "/data/attachments"

code_exec:
  workspace_dir: "/data/workspaces"
  # Must be the real absolute path on the DOCKER HOST, not this
  # container's own /data/workspaces above — the host-side sandbox
  # runner (compose/watcher/codeexec.sh) runs outside any container and
  # bind-mounts this path directly into the ephemeral sandbox container
  # it launches (see docs/plans/code-execution.md's "How Polaris's own
  # container reaches Docker"). install.sh's Docker path substitutes
  # @INSTALL_DIR@ with the real install path automatically; if editing
  # this by hand instead, point it at wherever docker-compose.yml's
  # ./workspaces volume actually resolves to on disk.
  host_workspace_dir: "@INSTALL_DIR@/workspaces"
  signal_dir: "/data/code-exec-signal"
  # Defaults to 120s (config/config.go) if omitted — raised from an
  # initial 30s after live production evidence: a weak quad-core SBC
  # running real numpy/matplotlib workloads genuinely needs the extra
  # headroom. Uncomment to tune further for slower/faster hardware.
  # timeout_seconds: 120

service:
  label: "polaris"

context_window_tokens: 200000
max_agent_turns: 50
default_model: "deepseek"

# Oracle mode tuning (opt-in in Settings; see README). Thresholds are the
# minimum probability Jev's answer needs for a check to fire; the lists
# decide which focus modes Oracle may pick, keep, or skip. All of this is
# optional — anything left out uses the value shown here — and it's re-read
# on every turn, so edits take effect without a restart. The wording Jev is
# asked, and the text injected into the answer, lives in prompts.yaml.
oracle:
  checks:
    focus:
      threshold: 0.70           # bar for Oracle to pick a focus mode at all
      switch_threshold: 0.85    # higher bar to change a mode Oracle already set
      # Per-mode bars above `threshold`. Brief can make an answer worse if
      # picked wrongly; Safari takes over the whole thread.
      option_thresholds:
        brief: 0.80
        safari: 0.85
      sticky: [safari]          # never switched away from once set for a thread
      never_with_high_stakes: [brief]   # not picked when high_stakes fired
    research:
      threshold: 0.85
    high_stakes:
      threshold: 0.75
    intent:
      threshold: 0.65
      # Shopper mode already carries its own product guidance.
      skip_option_for_focus:
        product: [shopper]
    clarify:
      threshold: 0.85
      first_message_only: true
      skip_for_focus: [safari]  # Safari's Embark step already asks
    recall:
      threshold: 0.80
    # Answer shape. Safari owns its own format; Brief is already short.
    format:
      threshold: 0.75
      skip_for_focus: [safari]
    # Whether a visual block (the Prism setting) would beat prose. Brief is a few
    # sentences and Safari runs its own pacing. When it fires it holds back
    # `format`, since two answer-shape nudges would contradict each other. On the
    # Low Prism setting the bar rises by visuals_low_offset; Off never asks.
    ui:
      threshold: 0.70
      skip_for_focus: [safari, brief]
      suppresses: [format]
      visuals_low_offset: 0.15
    depth:
      threshold: 0.80
      skip_for_focus: [safari, brief]
    # Source and evidence guidance.
    recency:
      threshold: 0.75
    source_type:
      threshold: 0.75
      # Academic mode already carries its own source guidance.
      skip_option_for_focus:
        academic: [academic]
    contested:
      threshold: 0.80
    claim_check:
      threshold: 0.80
    locale:
      threshold: 0.75
    # What the person is doing. These modes already teach the same way.
    task:
      threshold: 0.75
      skip_for_focus: [safari]
      skip_option_for_focus:
        explain: [first_principles, socratic]
    # Sensitivity: wrongly firing these changes tone, so the bar is high.
    emotional:
      threshold: 0.85
      # Tone over structure: someone who's struggling shouldn't also get a
      # table format, an agency-citation nudge, a step-by-step plan, or a
      # "stop and ask a question first" stacked on top. High-stakes, locale,
      # and freshness stay — those carry facts, not tone.
      suppresses: [format, depth, source_type, task, clarify, ui]
    private_person:
      threshold: 0.85
    premise:
      threshold: 0.85
  # Offer chips shown under a reply.
  chips:
    pulsar:
      threshold: 0.80
    daily:
      threshold: 0.80
    safari:
      threshold: 0.85
    field:
      threshold: 0.75
