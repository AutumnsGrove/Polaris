[Unit]
Description=Polaris code_exec sandbox runner (one-shot)
# A legitimate burst of concurrent code_exec tool calls can trigger
# polaris-codeexec.path (DirectoryNotEmpty) faster than one invocation
# finishes — this script's own `flock -n` early-exit path already
# handles that safely (see codeexec.sh's comment), but without this
# override systemd's default StartLimitIntervalSec=10/StartLimitBurst=5
# treats 5 such triggers within 10s as the unit "failing" and
# permanently disables it (unit-start-limit-hit) until someone notices
# and runs `systemctl reset-failed` by hand. Confirmed live: exactly
# this happened on 2026-09-17, stranding a live thread's code_exec
# call for ~23 hours (issue #85). Disabling the limit entirely is safe
# here specifically because flock already guarantees at most one real
# execution ever runs concurrently, regardless of how many times this
# unit gets started.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Same "invoking user, in the docker group, deliberately not root"
# reasoning as polaris-update.service — this script only ever runs one
# fixed, reviewable `docker run` invocation against a request file
# Polaris itself wrote, plus python3 for JSON handling. See
# codeexec.sh's own header comment for why the Docker socket never
# reaches the polaris container itself.
User=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/compose/watcher/codeexec.sh

# A code_exec call is on the critical path of a live chat turn a user
# is actively waiting on (unlike update.sh's background pull) — bounded
# well above the sandbox's own configured wall-clock timeout
# (config.Config.CodeExec.TimeoutSeconds, 30s default) plus its
# --kill-after grace and container start/stop overhead, but still a
# hard ceiling so a wedged docker daemon can't hang this unit forever.
TimeoutStartSec=120
