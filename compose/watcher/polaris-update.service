[Unit]
Description=Polaris Docker update watcher (one-shot)
# Same reasoning as procmgr/systemd.go's unit template: don't run this
# before the tunnel is up, since a pull that needs to reach the
# internet has no reason to fire before networking is actually usable.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the operator account that ran install.sh (same convention
# cmd/install.go uses for the bare-metal service — see its comment: the
# invoking user, not a dedicated system account), which install.sh adds
# to the host's `docker` group so `docker compose` works without sudo.
# Deliberately NOT root: this script only ever runs one fixed,
# reviewable command sequence (pull + recreate one named service), so
# there's nothing root privileges would add except blast radius if the
# script itself were ever compromised or misused.
User=@USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/compose/watcher/update.sh

# Generous but bounded — a slow registry pull on the potato's uplink
# shouldn't hang forever, but shouldn't get cut off mid-pull either.
#
# Must exceed the *sum* of update.sh's own internal timeouts, not just
# the slowest single one: watcher-sync-verify (60s) + docker compose pull
# (300s) + the sandbox image pull (300s) + the busy-wait for an in-flight
# turn/run (300s) + docker compose up (60s) + the healthcheck poll (120s)
# = 1140s worst case if every step happens to hit its own cap at once. A
# 600s budget here would let systemd SIGKILL the script mid-run well
# before any of its own timeouts fire, bypassing write_result/rollback
# entirely and leaving update-signal/requested never removed — the update
# would look stuck "in progress" forever instead of reporting the
# failure it was designed to report. 1800s leaves real headroom above the
# 1140s worst case.
TimeoutStartSec=1800
