# Copy to .env (gitignored) — docker-compose.yml reads this automatically
# and passes these through into the polaris container's environment,
# where config.yaml's ${VAR} placeholders (compose/polaris/config.yaml,
# copied from config.yaml.example) get expanded.

# Random value SearXNG's entrypoint substitutes into settings.yml's
# secret_key at container start — generate with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# Which polaris image docker-compose.yml actually runs. Leave unset —
# install.sh does too — and it falls back to the ghcr.io:latest tag
# (fine for a first install); compose/watcher/update.sh pins this to a
# specific digest every time "Update Polaris" runs afterward. Don't
# hand-edit this while the watcher is enabled; your edit will just get
# overwritten on the next update.
POLARIS_IMAGE=

# Required — see README's Requirements section for where to get each key.
OPENROUTER_API_KEY=

# Optional — leave blank to disable that tool/fallback; see README.
FOURSQUARE_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
PARALLEL_API_KEY=
GITHUB_TOKEN=
LASTFM_API_KEY=
HARDCOVER_API_KEY=
TMDB_API_KEY=

# Optional — off-device backup mirroring to a dedicated Cloudflare R2
# bucket. Leave blank to disable; local backups keep working unchanged.
# Uncomment r2: in compose/polaris/config.yaml too. See that file and
# README's Backups section. https://developers.cloudflare.com/r2/api/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
