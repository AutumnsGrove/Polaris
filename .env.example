# Copy to .env (gitignored) — docker-compose.yml reads this automatically
# and passes these through into the polaris container's environment,
# where config.yaml's ${VAR} placeholders (compose/polaris/config.yaml,
# copied from config.yaml.example) get expanded.

# Random value SearXNG's entrypoint substitutes into settings.yml's
# secret_key at container start — generate with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# Which polaris image docker-compose.yml actually runs. Leave unset for
# local dev (`docker compose up --build` uses the Dockerfile in this
# repo) — install.sh sets this to a real ghcr.io tag for a from-release
# install, and compose/watcher/update.sh rewrites it to a specific
# digest every time "Update Polaris" runs. Don't hand-edit this while
# the watcher is enabled; your edit will just get overwritten on the
# next update.
POLARIS_IMAGE=

# Required — see README's Requirements section for where to get each key.
OPENROUTER_API_KEY=

# Optional — leave blank to disable that tool/fallback; see README.
FOURSQUARE_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
LASTFM_API_KEY=
HARDCOVER_API_KEY=
TMDB_API_KEY=
